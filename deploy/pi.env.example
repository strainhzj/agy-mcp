# launch-pi launcher configuration (copy to your control dir's parent as
# pi.env, review every line, then source it from systemd or your shell).
# Every path is a HOST path; the launcher maps them into the sandbox.

# Deployment-assigned identity. One instance serves exactly one project; a
# second project gets a second instance with its own control dir, state dir,
# token and endpoint.
PI_PROJECT_ID=pi-review

# The host directory served as the read-only project snapshot. Give the
# sandbox a snapshot (a git worktree, an exported copy), not the live tree:
# the worker cannot write here, and the instance serves exactly this view.
PI_SNAPSHOT_DIR=/srv/workspaces/pi

# This instance's private job-state directory. Never shared with another
# instance, never the XDG default: the instance refuses a store holding jobs
# it did not create.
PI_STATE_DIR=/var/lib/agy-mcp/pi-review/state

# The launcher's private control-plane directory (instance id, bearer token,
# staged binaries and scripts). Back it with permissions that keep other
# users out; the launcher enforces 0700.
PI_CONTROL_DIR=/var/lib/agy-mcp/pi-review/control

# Loopback address the server binds inside the namespace. Publish the
# endpoint to a sandboxed client with a dedicated bridge (see README.md);
# never widen this bind.
PI_LISTEN_ADDR=127.0.0.1:8765

# Pinned binaries. Pin the agy version: an agy upgrade changes the security
# assumptions and must go through re-verification, not a rolling PATH lookup.
PI_AGY_BIN=/home/piagent/.local/bin/agy
PI_AGY_MCP_BIN=/usr/local/bin/agy-mcp
PI_BWRAP=/usr/bin/bwrap

# The service identity agy runs with (its own sign-in state, NOT the
# operator's personal ~/.gemini). Provision it once by running the pinned agy
# manually with HOME pointed at a scratch dir, then give the dir here. The
# launcher mounts it into the worker view only. Leave empty to start with no
# service identity: the cold-start check will refuse until agy can answer.
PI_AGY_CONFIG_DIR=/var/lib/agy-mcp/pi-review/agy-home/.gemini

# Controlled egress for the worker. When set, the worker inherits exactly
# these proxy variables and nothing else network-related.
PI_PROXY_URL=http://192.168.5.60:10808

# Server knobs (the profile fixes everything else).
PI_MAX_TIMEOUT=20m
PI_MAX_CONCURRENCY=2
PI_SYNC_WAIT_CAP=50s
