# launch-pi launcher configuration (copy to your control dir's parent as
# pi.env, review every line, then source it from systemd or your shell).
# Every path is a HOST path; the launcher maps them into the sandbox.

# Deployment-assigned identity. One instance serves exactly one project; a
# second project gets a second instance with its own control dir, state dir,
# token and endpoint.
# The charset is the project manifest's contract (lowercase letters, digits,
# dot, dash, underscore, starting with a letter or digit): the launcher and
# the server validate the same shape, so an id one accepts and the other
# refuses is a launch that dies at startup.
PI_PROJECT_ID=pi-review

# The host directory served as the read-only project snapshot. Give the
# sandbox a snapshot (a git worktree, an exported copy), not the live tree:
# the worker cannot write here, and the instance serves exactly this view.
# The launcher fingerprints this tree's CONTENT at launch (each file's bytes,
# not only its path/size/mtime) and the server binds that fingerprint into
# every job: redeploying with new content is a new deployment, and old
# idempotency keys are refused. A content digest matters because a redeploy
# can rewrite a file in place while keeping its size and timestamps, which a
# metadata-only fingerprint would not notice.
PI_SNAPSHOT_DIR=/srv/workspaces/pi

# This instance's private job-state directory. Never shared with another
# instance, never the XDG default: the launcher writes a deployment record
# (project, instance, snapshot fingerprint) here and the server refuses to
# start over a state dir whose record does not match.
PI_STATE_DIR=/var/lib/agy-mcp/pi-review/state

# The launcher's private control-plane directory (instance id, bearer token,
# staged binaries and scripts). Back it with permissions that keep other
# users out; the launcher enforces 0700.
PI_CONTROL_DIR=/var/lib/agy-mcp/pi-review/control

# Loopback address the server binds inside the namespace. Give EACH instance
# its own dedicated 127.x.x.x address (the loopback /8 is instance address
# space; 127.0.0.8 is the example default). The unit's egress drop-in then
# admits exactly this one address, so a worker that dials any other host
# loopback service (a database, another instance's endpoint) is denied by the
# kernel. The shared 127.0.0.1 is refused by the launcher: on it, the
# allowlist cannot distinguish this endpoint from every other host service.
# Publish the endpoint to a sandboxed client with a dedicated bridge (see
# README.md); never widen this bind.
PI_LISTEN_ADDR=127.0.0.8:8765

# The HTTP Host allowlist the server enforces. REQUIRED, no default: it names
# the published endpoint a sandboxed client actually reaches and this
# instance's own listen address. The bridge forwards the client's Host header,
# so the server must admit the published address; anything else is refused
# with 403. This is what replaces the SDK's localhost Host check, which the
# profile disables so a bridge-published Host can reach the JSON-RPC layer.
# A wrong or missing value locks out the real client, so the launcher refuses
# to start rather than guessing.
PI_ALLOWED_HOSTS=192.168.5.45:8865,127.0.0.8:8765

# Pinned binaries. Pin the agy version: an agy upgrade changes the security
# assumptions and must go through re-verification, not a rolling PATH lookup.
PI_AGY_BIN=/home/piagent/.local/bin/agy
PI_AGY_MCP_BIN=/usr/local/bin/agy-mcp
PI_BWRAP=/usr/bin/bwrap

# The service identity agy runs with (its own sign-in state, NOT the
# operator's personal ~/.gemini). Provision it once by running the pinned agy
# manually with HOME pointed at a scratch dir, then give the dir here. The
# launcher mounts it into the worker view only. Leave empty to start with no
# service identity: the cold-start check will refuse until agy can answer.
PI_AGY_CONFIG_DIR=/var/lib/agy-mcp/pi-review/agy-home/.gemini

# Controlled egress for the worker. When set, the worker inherits exactly
# these proxy variables. The proxy variables are configuration for agy, NOT
# the enforcement: a workspace hook can drop them and connect directly. The
# enforced boundary is the unit's IPAddressAllow/IPAddressDeny allowlist
# (see agy-mcp-pi@.service), which the operator provisions with the proxy's
# address (an IP literal avoids a DNS dependency). Workers reach only what
# that allowlist names, with or without these variables.
PI_PROXY_URL=http://192.168.5.60:10808

# Server knobs (the profile fixes everything else).
PI_MAX_TIMEOUT=20m
PI_MAX_CONCURRENCY=2
PI_SYNC_WAIT_CAP=50s

# Session policy. disabled (default) is single-turn: no conversation
# continuation at all. managed-only is the Phase 3 mode: a completed run's
# conversation_id carries an opaque handle this instance issued, and passing
# it back as conversation_id continues that conversation. Handles are bound
# to this instance, project and snapshot version and expire after
# PI_SESSION_TTL (default 168h). Native agy ids are never accepted under
# either setting, and list_sessions stays off.
#PI_SESSION_POLICY=disabled
#PI_SESSION_TTL=168h

# Optional cgroup subtree the whole instance tree enrolls into (resource caps
# plus the nft egress whitelist scope). Prepared by the root-side setup
# script on hosts WITHOUT systemd (a container):
#   sudo ./setup-pi-local-root.sh /sys/fs/cgroup/agy-pi-review piagent 3128
# The launcher fails closed when this is set but not usable, so run the
# setup first and only then point PI_CGROUP at it. Leave unset on a normal
# systemd host (the unit enforces the equivalent boundaries).
#PI_CGROUP=/sys/fs/cgroup/agy-pi-review

# Size bound on the worker's per-job .gemini tmpfs. Each job's agy gets a
# FRESH COPY of the service identity (seeded from PI_AGY_CONFIG_DIR at job
# start) on a size-limited tmpfs: a stuck job cannot fill the host disk
# through it, and no job's writes survive into the next job. Token refreshes
# a job makes are therefore not carried into later jobs; if your provider
# rotates refresh tokens and a later job fails to authenticate, re-provision
# the service identity (README.md, provisioning step).
PI_GEMINI_TMPFS_SIZE=256MiB
